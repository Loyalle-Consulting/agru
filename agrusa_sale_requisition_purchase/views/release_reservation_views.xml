<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agrusa_requisition_release_form" model="ir.ui.view">
        <field name="name">agrusa.requisition.release.form</field>
        <field name="model">agrusa.requisition.release</field>
        <field name="arch" type="xml">
            <form string="Liberar reserva de Requisición">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="line_id" domain="[('order_id', '=', order_id), ('agrusa_supply_origin', '=', 'requisition')]"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button name="action_release" type="object" string="Liberar cantidad" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
