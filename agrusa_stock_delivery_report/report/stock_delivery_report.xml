<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="agrusa_custom_header">
    <t t-set="header_address" t-value="o.company_id.partner_id"/>
    <div class="row" style="font-size:11.5px;line-height:1.30;">
      <div class="col-8" style="font-size:11.5px;line-height:1.30;">
        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height:56px;max-width:225px;display:inline-block;margin-bottom:5px;" alt="AGRUSA"/>
        <br/>
        <strong style="font-size:12px;"><span t-field="o.company_id.partner_id.name"/></strong><br/>
        <span class="fst-italic" style="font-size:11.5px;line-height:1.30;" t-field="o.company_id.l10n_cl_activity_description"/><br/>
        <span t-out="' - '.join([item for item in [', '.join([item for item in [header_address.street, header_address.street2] if item]), header_address.zip, header_address.country_id.name if header_address.country_id else ''] if item])"/>
        <br/>
        <span t-if="header_address.phone" t-out="'Tel: ' + header_address.phone"/>
        <span t-if="header_address.website or header_address.email" t-att-style="'color: %s;' % o.company_id.primary_color" t-out="' - Web: ' + ' - '.join([item for item in [(header_address.website or '').replace('https://', '').replace('http://', ''), header_address.email or ''] if item])"/>
      </div>
      <div class="col-4" style="font-size:11.5px;line-height:1.3;">
        <div class="border border-dark text-center p-2" t-att-style="'color: %s;' % o.company_id.primary_color">
          <strong>RUT: <span t-field="o.company_id.partner_id.vat"/></strong><br/>
          <strong t-if="o.picking_type_id.code == 'outgoing'">DOCUMENTO DE ENTREGA</strong>
          <strong t-else="">DOCUMENTO DE TRASLADO INTERNO</strong><br/>
          <strong>Nº: <span t-field="o.name"/></strong>
        </div>
        <div class="text-center" t-att-style="'color: %s;' % o.company_id.primary_color">
          <span t-field="o.company_id.l10n_cl_sii_regional_office"/>
        </div>
      </div>
    </div>
  </template>

  <template id="delivery_nv">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="custom_header" t-value="'agrusa_stock_delivery_report.agrusa_custom_header'"/>
        <t t-call="web.external_layout">
          <div class="page">
            <div class="row mt-3 mb-2" style="border:1px solid #a5bdca;border-radius:7px;padding:12px;font-size:11.5px;line-height:1.45;page-break-inside:avoid;">
              <div class="col-6">
                <strong>Fecha:</strong> <span t-field="o.scheduled_date" t-options="{'widget':'date'}"/><br/>
                <t t-if="o.picking_type_id.code == 'outgoing'">
                  <strong>Cliente:</strong> <span t-out="o.partner_id.commercial_partner_id.name or o.partner_id.name or ''"/><br/>
                  <strong>RUT:</strong> <span t-out="o.partner_id.vat or ''"/><br/>
                  <strong>GIRO:</strong> <span t-out="o.partner_id.commercial_partner_id.l10n_cl_activity_description or o.partner_id.l10n_cl_activity_description or ''"/>
                </t>
                <t t-else="">
                  <strong>Origen:</strong> <span t-field="o.location_id"/><br/>
                  <strong>Destino:</strong> <span t-field="o.location_dest_id"/>
                </t>
              </div>
              <div class="col-6">
                <t t-if="o.partner_id">
                  <strong>Domicilio:</strong>
                  <span t-field="o.partner_id" t-options="{'widget':'contact','fields':['address'],'no_marker':True,'no_tag_br':True}"/><br/>
                </t>
                <strong>Documento origen:</strong> <span t-field="o.origin"/><br/>
                <strong>Transferencia:</strong> <span t-field="o.name"/><br/>
                <strong>Estado:</strong>
                <span t-if="o.state == 'done'">Realizado - cantidades transferidas</span>
                <span t-else="">Provisional - cantidades previstas</span>
              </div>
            </div>
            <table class="table table-borderless o_has_total_table" style="font-size:10px;" t-if="o.move_ids">
              <thead>
                <tr t-att-style="'background-color:%s;color:white;' % (o.company_id.primary_color or '#0876A7')">
                  <th>CÓDIGO</th><th>PRODUCTO / DESCRIPCIÓN</th>
                  <th class="text-end">CANTIDAD</th><th>UNIDAD</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="o.move_ids.filtered(lambda m: m.state != 'cancel' and (m.quantity if o.state == 'done' else m.product_uom_qty) &gt; 0)" t-as="line">
                  <tr>
                    <td><span t-field="line.product_id.default_code"/></td>
                    <td>
                      <strong><span t-field="line.product_id.name"/></strong>
                      <t t-if="line.product_id.description_picking"><br/><span t-field="line.product_id.description_picking"/></t>
                      <t t-if="'description_picking' in line._fields and line.description_picking"><br/><span t-out="line.description_picking" style="white-space:pre-line;"/></t>
                      <t t-if="line.move_line_ids.filtered(lambda ml: ml.lot_id or ml.lot_name)">
                        <t t-foreach="line.move_line_ids.filtered(lambda ml: ml.lot_id or ml.lot_name)" t-as="ml">
                          <br/><small>Lote / serie: <span t-out="ml.lot_id.name or ml.lot_name"/></small>
                        </t>
                      </t>
                    </td>
                    <td class="text-end">
                      <span t-if="o.state == 'done'" t-out="line.quantity" t-options="{'widget':'float','precision':2}"/>
                      <span t-else="" t-out="line.product_uom_qty" t-options="{'widget':'float','precision':2}"/>
                    </td>
                    <td><span t-field="line.product_uom"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
            <t t-if="o.note"><div class="mt-3"><strong>Observaciones generales:</strong><div t-field="o.note"/></div></t>
            <!-- Solo se reproduce el timbre SII real asociado a ESTE picking y a su DTE emitido. -->
            <t t-if="o.picking_type_id.code in ('outgoing', 'internal') and o.l10n_cl_sii_barcode and o.l10n_latam_document_number">
              <div class="row mt-4" style="page-break-inside:avoid;">
                <div class="col-5 text-center">
                  <t t-set="agrusa_stamp" t-value="o._pdf417_barcode(o.l10n_cl_sii_barcode)"/>
                  <img t-if="agrusa_stamp" class="img-fluid" t-attf-src="data:image/*;base64,{{agrusa_stamp}}" style="max-width:260px;max-height:140px;"/>
                  <div style="font-size:9px;color:#0876A7;">Timbre auténtico de la Guía de Despacho Electrónica asociada, Nº <span t-field="o.l10n_latam_document_number"/>.</div>
                </div>
                <div class="col-7" style="font-size:9px;align-self:center;">
                  Referencia al DTE original. Esta impresión sin valores es un documento operativo y no reemplaza la Guía de Despacho Electrónica emitida.
                </div>
              </div>
            </t>
            <div class="row mt-5" style="page-break-inside:avoid;">
              <div class="col-6 text-center"><div style="border-top:1px solid #777;margin:30px 25px 0;"/>Entregado por</div>
              <div class="col-6 text-center"><div style="border-top:1px solid #777;margin:30px 25px 0;"/>Recibido por</div>
            </div>
            <p class="mt-3 text-center small">Documento operativo sin valores monetarios. No constituye documento tributario.</p>
          </div>
        </t>
      </t>
    </t>
  </template>

  <record id="action_report_stock_delivery_no_values" model="ir.actions.report">
    <field name="name">Documento de entrega / traslado sin valores</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">agrusa_stock_delivery_report.delivery_nv</field>
    <field name="report_file">agrusa_stock_delivery_report.delivery_nv</field>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">'Entrega_Traslado_%s' % (object.name or '').replace('/', '_')</field>
  </record>
</odoo>
