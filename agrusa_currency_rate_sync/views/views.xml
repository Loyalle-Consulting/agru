<record id="log_list" model="ir.ui.view"><field name="name">agrusa.currency.sync.log.list</field><field name="model">agrusa.currency.sync.log</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="company_id"/><field name="mode"/><field name="status"/><field name="summary"/></list></field></record>
<record id="log_form" model="ir.ui.view"><field name="name">agrusa.currency.sync.log.form</field><field name="model">agrusa.currency.sync.log</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="create_date"/><field name="company_id"/><field name="mode"/><field name="status"/><field name="summary"/><field name="detail"/></group></sheet></form></field></record>
<record id="action_sync" model="ir.actions.act_window"><field name="name">Configuración BCCh</field><field name="res_model">agrusa.currency.sync</field><field name="view_mode">list,form</field></record>
<record id="action_log" model="ir.actions.act_window"><field name="name">Historial BCCh</field><field name="res_model">agrusa.currency.sync.log</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_root" name="Paridades Banco Central" parent="account.menu_finance" groups="base.group_system" sequence="95"/>
<menuitem id="menu_sync" name="Configuración" parent="menu_root" action="action_sync"/>
<menuitem id="menu_log" name="Historial" parent="menu_root" action="action_log"/>
