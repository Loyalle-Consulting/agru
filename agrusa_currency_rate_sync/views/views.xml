<odoo>
<record id="sync_list" model="ir.ui.view"><field name="name">agrusa.currency.sync.list</field><field name="model">agrusa.currency.sync</field><field name="arch" type="xml"><list><field name="company_id"/><field name="enabled"/><field name="days"/><field name="last_run"/><field name="last_result"/></list></field></record>
