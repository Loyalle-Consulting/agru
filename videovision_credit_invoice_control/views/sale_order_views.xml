<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_vv_credit_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.vv.credit.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="videovision_credit_control.view_order_form_vv_credit"/>
        <field name="arch" type="xml">
            <!-- Reunión 12-nov: mientras el pedido está pendiente de aprobación, "Crear factura" queda deshabilitado.
                 El aprobador usa "Aprobar / rechazar crédito"; una vez aprobado, el botón vuelve. -->
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or vv_credit_state == 'pending'</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">invoice_status != 'no' or state != 'sale' or vv_credit_state == 'pending'</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice']" position="before">
                <button name="action_vv_credit_pending_info" type="object" string="Crear factura"
                        class="btn-secondary disabled" title="Pendiente de aprobación de crédito"
                        invisible="vv_credit_state != 'pending' or state != 'sale'"/>
            </xpath>
            <xpath expr="//button[@name='action_vv_credit_decide']" position="attributes">
                <attribute name="invisible">vv_credit_state != 'pending'</attribute>
            </xpath>
            <xpath expr="//div[hasclass('alert-danger')][.//field[@name='vv_credit_block_reason']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('alert-secondary')][.//field[@name='vv_credit_decision_note']]" position="attributes">
                <attribute name="invisible">vv_credit_state != 'rejected'</attribute>
            </xpath>
            <xpath expr="//field[@name='vv_credit_alert']" position="attributes">
                <attribute name="invisible">not vv_credit_alert or state not in ('draft', 'sent', 'sale')</attribute>
            </xpath>
            <xpath expr="//field[@name='vv_credit_alert']" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="vv_credit_state != 'pending'">
                    <i class="fa fa-hand-paper-o me-1" role="img" aria-label="icono" title="icono"/>
                    <strong>Pendiente de aprobación · <field name="vv_credit_block_reason" readonly="1" class="oe_inline"/></strong>:
                    no se puede facturar hasta que un responsable de crédito lo apruebe
                    (factura retenida por <field name="vv_credit_pending_amount" readonly="1" class="oe_inline"/>).
                    El pedido sí está confirmado y reserva stock.
                    Retenido por <field name="vv_credit_requested_by" readonly="1" class="oe_inline" options="{'no_open': True}"/>
                    el <field name="vv_credit_request_date" readonly="1" class="oe_inline"/>.
                </div>
                <div class="alert alert-info mb-0 py-1" role="status"
                     invisible="vv_credit_state != 'approved' or state != 'sale'">
                    <i class="fa fa-check me-1" role="img" aria-label="icono" title="icono"/>
                    Crédito aprobado por <field name="vv_credit_approved_by" readonly="1" class="oe_inline" options="{'no_open': True}"/>
                    para facturar hasta <field name="vv_credit_approved_amount" readonly="1" class="oe_inline"/>.
                </div>
            </xpath>
            <xpath expr="//group[@name='vv_credit']/group[1]" position="inside">
                <field name="vv_credit_pending_amount" invisible="not vv_credit_pending_amount"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_vv_credit_invoice" model="ir.ui.view">
        <field name="name">sale.order.list.vv.credit.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="vv_credit_block_reason" string="Crédito" optional="show" widget="badge"
                       decoration-danger="vv_credit_block_reason in ('overdue', 'both')"
                       decoration-warning="vv_credit_block_reason in ('limit', 'always')"
                       invisible="vv_credit_state != 'pending'"/>
                <field name="vv_credit_state" column_invisible="True"/>
                <field name="vv_credit_pending_amount" optional="hide" sum="Total"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_vv_credit_invoice" model="ir.ui.view">
        <field name="name">sale.order.search.vv.credit.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="videovision_credit_control.view_sales_order_filter_vv_credit"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='vv_credit_pending']" position="attributes">
                <attribute name="string">Pendientes de aprobación</attribute>
                <attribute name="domain">[('vv_credit_state', '=', 'pending')]</attribute>
            </xpath>
            <xpath expr="//filter[@name='vv_group_credit_reason']" position="before">
                <filter name="vv_reserved_credit_issue" string="Reserva con problema de crédito"
                        domain="[('vv_reserved_credit_issue', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="videovision_credit_control.action_vv_credit_pending_orders" model="ir.actions.act_window">
        <field name="name">Pendientes de aprobación</field>
        <field name="view_id" ref="sale.view_order_tree"/>
        <field name="domain">[('vv_credit_state', '=', 'pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay pedidos pendientes de aprobación de crédito</p>
            <p>Un pedido queda aquí cuando se intenta facturar y el cliente está moroso o supera su línea.</p>
        </field>
    </record>

    <record id="action_vv_reserved_credit_issue" model="ir.actions.act_window">
        <field name="name">Reservas con problema de crédito</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale.view_order_tree"/>
        <field name="domain">[('vv_reserved_credit_issue', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ningún pedido con stock reservado pertenece a clientes morosos o sobre su línea</p>
        </field>
    </record>
</odoo>
