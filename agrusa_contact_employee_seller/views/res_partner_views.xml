<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_partner_form_agrusa_seller_employee" model="ir.ui.view">
    <field name="name">res.partner.form.agrusa.seller.employee</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='user_id']" position="after">
        <field name="agrusa_seller_employee_id" groups="hr.group_hr_user,base.group_system,sales_team.group_sale_salesman"/>
      </xpath>
      <xpath expr="//field[@name='user_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>
</odoo>
