<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_country_commune_list" model="ir.ui.view">
        <field name="name">res.country.commune.list</field>
        <field name="model">res.country.commune</field>
        <field name="arch" type="xml">
            <list string="Comunas" default_order="state_id,name">
                <field name="name"/>
                <field name="province"/>
                <field name="state_id"/>
                <field name="country_id" optional="hide"/>
                <field name="code" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_res_country_commune_form" model="ir.ui.view">
        <field name="name">res.country.commune.form</field>
        <field name="model">res.country.commune</field>
        <field name="arch" type="xml">
            <form string="Comuna">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="province"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="state_id" domain="[('country_id.code', '=', 'CL')]"/>
                            <field name="country_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_country_commune_search" model="ir.ui.view">
        <field name="name">res.country.commune.search</field>
        <field name="model">res.country.commune</field>
        <field name="arch" type="xml">
            <search string="Buscar comunas">
                <field name="name"/>
                <field name="province"/>
                <field name="state_id"/>
                <filter string="Agrupar por Región" name="group_state" context="{'group_by': 'state_id'}"/>
                <filter string="Agrupar por Provincia" name="group_province" context="{'group_by': 'province'}"/>
            </search>
        </field>
    </record>

    <record id="action_res_country_commune" model="ir.actions.act_window">
        <field name="name">Comunas</field>
        <field name="res_model">res.country.commune</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_res_country_commune_search"/>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <menuitem id="menu_res_country_commune"
              name="Comunas"
              parent="contacts.menu_localisation"
              action="action_res_country_commune"
              sequence="35"
              groups="base.group_system"/>
</odoo>
