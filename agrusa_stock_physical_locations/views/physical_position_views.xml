<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agrusa_position_list" model="ir.ui.view">
        <field name="name">agrusa.physical.position.list</field>
        <field name="model">agrusa.physical.position</field>
        <field name="arch" type="xml">
            <list string="Posiciones de Bodega">
                <field name="name"/><field name="aisle"/><field name="rack"/>
                <field name="longitudinal"/><field name="level"/><field name="position_type"/><field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_agrusa_position_form" model="ir.ui.view">
        <field name="name">agrusa.physical.position.form</field>
        <field name="model">agrusa.physical.position</field>
        <field name="arch" type="xml">
            <form string="Posicion de Bodega">
                <sheet>
                    <group>
                        <group><field name="name" readonly="1"/><field name="aisle"/><field name="rack"/><field name="longitudinal"/></group>
                        <group><field name="level"/><field name="position_type"/><field name="active"/></group>
                    </group>
                    <field name="note"/>
                    <notebook>
                        <page string="Ubicaciones Odoo vinculadas">
                            <field name="location_ids" readonly="1">
                                <list><field name="agrusa_position_warehouse_id"/><field name="complete_name"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_agrusa_physical_position" model="ir.actions.act_window">
        <field name="name">Posiciones de Bodega</field>
        <field name="res_model">agrusa.physical.position</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_agrusa_physical_positions" name="Posiciones de Bodega"
              parent="stock.menu_stock_config_settings" action="action_agrusa_physical_position"
              sequence="75" groups="stock.group_stock_user"/>
</odoo>
