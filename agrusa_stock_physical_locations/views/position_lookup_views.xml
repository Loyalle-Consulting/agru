<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_agrusa_position_lookup_form" model="ir.ui.view">
    <field name="name">agrusa.position.lookup.form</field>
    <field name="model">agrusa.position.lookup</field>
    <field name="arch" type="xml">
      <form string="Consultar posiciones disponibles" create="false" edit="false">
        <group>
          <field name="product_id"/>
          <field name="warehouse_id"/>
          <field name="demand_qty"/>
          <field name="direction" string="Posiciones de"/>
          <field name="consultation_only" readonly="1"/>
        </group>
        <field name="position_line_ids" nolabel="1">
          <list create="false" delete="false" edit="false">
            <field name="position_id" string="Posicion fisica"/>
            <field name="qty_on_hand"/>
            <field name="qty_reserved"/>
            <field name="qty_free"/>
            <button name="action_select_position" type="object" string="Seleccionar" icon="fa-check" column_invisible="parent.consultation_only"/>
          </list>
        </field>
        <footer>
          <button string="Cerrar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
