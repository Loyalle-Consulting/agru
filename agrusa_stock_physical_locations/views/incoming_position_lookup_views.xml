<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agrusa_incoming_position_lookup_form" model="ir.ui.view">
        <field name="name">agrusa.incoming.position.lookup.form</field>
        <field name="model">agrusa.incoming.position.lookup</field>
        <field name="arch" type="xml">
            <form string="Consultar posiciones de destino" create="false" edit="false" delete="false">
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="warehouse_id" readonly="1"/>
                </group>
                <field name="position_line_ids" nolabel="1" readonly="1">
                    <list create="false" edit="false" delete="false">
                        <field name="position_id" string="Posicion fisica"/>
                        <field name="location_id" string="Ubicacion existente" optional="hide"/>
                        <field name="qty_on_hand"/>
                        <field name="qty_reserved"/>
                        <field name="qty_free"/>
                    </list>
                </field>
                <footer><button string="Cerrar" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
    <record id="view_agrusa_stock_move_line_incoming_consult" model="ir.ui.view">
        <field name="name">agrusa.stock.move.line.incoming.consult</field>
        <field name="model">stock.move.line</field>
        <field name="active" eval="False"/>
        <field name="inherit_id" ref="agrusa_stock_physical_locations.view_agrusa_stock_move_line_operation_positions"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_agrusa_consult_positions']" position="after">
                <button name="action_agrusa_consult_incoming_positions" type="object"
                        string="Consultar posiciones" icon="fa-search"
                        column_invisible="context.get('picking_code') != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
