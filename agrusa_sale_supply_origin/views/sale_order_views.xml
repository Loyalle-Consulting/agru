<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_agrusa_supply_origin" model="ir.ui.view">
        <field name="name">sale.order.form.agrusa.supply.origin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="agrusa_import_sale_pricing.agrusa_sale_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='agrusa_import_purchase_line_id']" position="before">
                <field name="agrusa_supply_origin" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='agrusa_import_purchase_line_id']" position="before">
                <field name="agrusa_supply_origin"/>
            </xpath>
        </field>
    </record>
</odoo>
