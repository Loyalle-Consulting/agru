<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_agru_currency_lock_website" model="ir.ui.view">
        <field name="name">sale.order.form.loyalle.currency.lock.website</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="agru_sale_currency_lock.view_order_form_agru_currency_lock"/>
        <field name="arch" type="xml">

            <field name="total_currency_id" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent') or website_id</attribute>
            </field>

            <field name="total_currency_rate" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent') or website_id</attribute>
            </field>

            <field name="total_currency_locked" position="after">
                <field name="website_id" invisible="1"/>
                <span class="text-muted" invisible="not website_id" colspan="2">
                    Pedido del sitio web: la moneda se fija automáticamente a la
                    moneda real de la tienda y no se puede editar aquí.
                </span>
            </field>

        </field>
    </record>

</odoo>
