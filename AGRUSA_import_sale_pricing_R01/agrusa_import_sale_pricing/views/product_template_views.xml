<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agrusa_product_template_import_factor_form" model="ir.ui.view">
        <field name="name">product.template.form.agrusa.import.factor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <group string="Parametros de importacion AGRUSA">
                    <field name="agrusa_default_import_factor"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
