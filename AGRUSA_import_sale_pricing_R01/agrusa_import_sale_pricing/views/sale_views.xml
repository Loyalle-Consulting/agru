<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="agrusa_sale_form" model="ir.ui.view">
  <field name="name">sale.order.form.agrusa.import.pricing</field>
  <field name="model">sale.order</field>
  <field name="inherit_id" ref="sale.view_order_form"/>
  <field name="priority">95</field>
  <field name="arch" type="xml">
   <xpath expr="//field[@name='total_currency_rate']" position="after">
    <field name="agrusa_import_fx_rate" invisible="total_currency_id == False"/>
   </xpath>
   <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
    <field name="agrusa_import_purchase_line_id" context="{'agrusa_import_selector': True}" optional="show"/>
    <field name="agrusa_import_available_qty" optional="show" readonly="1"/>
    <field name="agru_manual_price" column_invisible="True"/>
    <field name="agrusa_oc_factor_price" optional="show" readonly="1"/>
    <field name="agrusa_average_factor_price" optional="show" readonly="1"/>
    <field name="agrusa_general_average_price" string="PROMEDIO GENERAL" optional="show" readonly="1"/>
    <field name="agru_suggested_price" optional="show" readonly="1"/>
    <field name="agru_price_difference_pct" optional="show" readonly="1"/>
    <field name="agru_price_advice" optional="show" readonly="1" decoration-danger="agru_price_difference_pct &lt; 0" decoration-warning="agru_price_difference_pct &gt; 0"/>
   </xpath>
   <xpath expr="//field[@name='order_line']//form//field[@name='product_uom_id']" position="after">
    <field name="agrusa_import_purchase_line_id" context="{'agrusa_import_selector': True}"/>
    <field name="agrusa_import_available_qty" readonly="1"/>
    <field name="agru_manual_price" invisible="1"/>
    <field name="agrusa_oc_factor_price" readonly="1"/>
    <field name="agrusa_average_factor_price" readonly="1"/>
    <field name="agrusa_general_average_price" string="PROMEDIO GENERAL" readonly="1"/>
    <field name="agru_suggested_price" readonly="1"/>
    <field name="agru_price_difference_pct" readonly="1"/>
    <field name="agru_price_advice" readonly="1"/>
   </xpath>
  </field>
 </record>
</odoo>
