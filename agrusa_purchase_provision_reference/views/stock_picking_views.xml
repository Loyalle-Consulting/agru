<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_provision_reference" model="ir.ui.view">
        <field name="name">stock.picking.form.agrusa.provision.reference</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="agrusa_provision_reference" readonly="1" invisible="not purchase_id"/>
            </xpath>
        </field>
    </record>
</odoo>
