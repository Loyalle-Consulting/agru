<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_line_tree_provision_reference" model="ir.ui.view">
        <field name="name">purchase.order.line.list.agrusa.provision.reference</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_id']" position="after">
                <field name="agrusa_provision_reference" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
