<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_provision_reference" model="ir.ui.view">
        <field name="name">purchase.order.form.agrusa.provision.reference</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="agrusa_provision_reference" placeholder="Referencia interna de provisión"/>
            </xpath>
        </field>
    </record>
</odoo>
